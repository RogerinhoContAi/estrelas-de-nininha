rules_version = '2';
// Regras de segurança do banco (cole no Firebase, veja GUIA.md).
// Só quem sabe o código da família (12+ letras aleatórias, vai no link) acessa os dados.
// Ninguém consegue listar as famílias para descobrir códigos.
// Os textos do Cantinho do coração chegam cifrados com a senha da filha:
// quem tiver acesso ao banco vê só letras embaralhadas.
service cloud.firestore {
  match /databases/{database}/documents {
    function familiaExiste(codigo) {
      return exists(/databases/$(database)/documents/familias/$(codigo));
    }

    match /familias/{codigo} {
      allow get, create, update: if request.auth != null && codigo.size() >= 12;
      allow list, delete: if false;

      // A leitura não pode conferir o formato do nome do dia: o app lê a lista
      // inteira de dias, e o Firebase recusa listas com regra sobre o nome.
      match /dias/{dia} {
        allow read: if request.auth != null
          && codigo.size() >= 12
          && familiaExiste(codigo);
        allow write: if request.auth != null
          && codigo.size() >= 12
          && familiaExiste(codigo)
          && dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      match /diario/{entrada} {
        allow read: if request.auth != null && codigo.size() >= 12 && familiaExiste(codigo);
        // só cria textos cifrados; ninguém edita nem apaga pelo app
        allow create: if request.auth != null
          && codigo.size() >= 12
          && familiaExiste(codigo)
          && request.resource.data.keys().hasOnly(['cofreId', 'data', 'tipo', 'iv', 'dados', 'criadoEm'])
          && request.resource.data.dados is string
          && request.resource.data.dados.size() < 20000;
        allow update, delete: if false;
      }
    }
  }
}
